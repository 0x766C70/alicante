{{- $pages := where .Data.Pages "Kind" "not in" (slice "sitemap") -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range $pages }}
  {{- if not .Params.noindex }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if .Lastmod }}
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    <changefreq>
      {{- if eq .Kind "home" }}always
      {{- else if eq .Kind "page" }}monthly
      {{- else }}weekly
      {{- end -}}
    </changefreq>
    <priority>
      {{- if eq .Kind "home" }}1.0
      {{- else if .Params.pilier }}0.9
      {{- else if and (eq .Kind "page") (eq .Section "posts") }}0.8
      {{- else if eq .Kind "page" }}0.6
      {{- else if eq .Kind "taxonomy" }}0.4
      {{- else if eq .Kind "term" }}0.4
      {{- else }}0.5
      {{- end -}}
    </priority>
  </url>
  {{- end }}
  {{- end }}
</urlset>
